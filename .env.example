# Copie para .env.local (para rodar no seu computador) ou cadastre na Vercel
# em Settings > Environment Variables. No Supabase, botão Connect > Framework > Next.js:
# copie as duas linhas do .env.local. (O nome antigo NEXT_PUBLIC_SUPABASE_ANON_KEY também funciona.)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Entrega 3 · API de ponto (valores da API de demonstração; depois, os do seu fornecedor)
PONTO_API_URL=https://api-ponto-demo.vercel.app
PONTO_CLIENT_ID=vila-tempero
PONTO_API_KEY=vt_key_aulao2026
PONTO_API_SECRET=vt_secret_7f3a9c2e

# Teste de notas na SEFAZ (só no seu computador, em .env.local). Nunca coloque o certificado dentro do projeto.
SEFAZ_CERT_PATH=C:\certificado\NOME-DO-ARQUIVO.pfx
SEFAZ_CERT_SENHA=
SEFAZ_CNPJ=00000000000000
# Opcionais: SEFAZ_UF_AUTOR=35  SEFAZ_AMBIENTE=1  SEFAZ_MAX_LOTES=1  SEFAZ_URL=  SEFAZ_CA_PATH=
